rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/access_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/access_profiles/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/access_profiles/$(request.auth.uid)).data.active != false;
    }

    function isAdmin() {
      return adminProfile();
    }

    function clientOwns(clientId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/access_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/access_profiles/$(request.auth.uid)).data.role == 'client' &&
        get(/databases/$(database)/documents/access_profiles/$(request.auth.uid)).data.active != false &&
        get(/databases/$(database)/documents/access_profiles/$(request.auth.uid)).data.clientId == clientId;
    }

    match /access_profiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /portfolio/{docId} {
      allow read, write: if isAdmin();
    }

    match /portfolio_client_overviews/{clientId} {
      allow read: if isAdmin() || clientOwns(clientId);
      allow write: if isAdmin();
    }

    match /portfolio_archived_clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /reportLinks/{token} {
      allow read: if isAdmin() || (resource.data.expiresAt is int && resource.data.expiresAt > request.time.toMillis());
      allow create, update: if isAdmin() &&
        request.resource.data.expiresAt is int &&
        request.resource.data.expiresAt > request.time.toMillis();
      allow delete: if isAdmin();
    }

    match /admin_password_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /support_threads/{clientId} {
      allow read: if isAdmin() || clientOwns(clientId);
      allow create: if isAdmin() || (
        clientOwns(clientId) &&
        request.resource.data.clientId == clientId &&
        request.resource.data.adminUnreadCount is int &&
        request.resource.data.adminUnreadCount >= 1
      );
      allow update: if isAdmin() || (
        clientOwns(clientId) &&
        request.resource.data.clientId == clientId &&
        resource.data.adminUnreadCount is int &&
        request.resource.data.adminUnreadCount is int &&
        request.resource.data.adminUnreadCount >= resource.data.adminUnreadCount
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || clientOwns(clientId);
        allow create: if (
          isAdmin() &&
          request.resource.data.clientId == clientId &&
          request.resource.data.senderRole == 'admin'
        ) || (
          clientOwns(clientId) &&
          request.resource.data.clientId == clientId &&
          request.resource.data.senderRole == 'client' &&
          request.resource.data.clientRead == true
        );
        allow update: if isAdmin() || (
          clientOwns(clientId) &&
          resource.data.senderRole == 'admin' &&
          request.resource.data.senderRole == resource.data.senderRole &&
          request.resource.data.clientId == resource.data.clientId &&
          request.resource.data.text == resource.data.text &&
          request.resource.data.senderName == resource.data.senderName &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.edited == resource.data.edited &&
          request.resource.data.clientRead == true &&
          request.resource.data.clientReadAt is int &&
          request.resource.data.updatedAt is int
        );
        allow delete: if isAdmin();
      }
    }

    match /auth_login_events/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.uid is string &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.authEventKey is string &&
        request.resource.data.loginAt is int &&
        request.resource.data.loginAt > 0 &&
        request.resource.data.createdAt is int &&
        request.resource.data.createdAt > 0;
      allow update, delete: if false;
    }

    match /auth_presence/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'lastSeen']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.lastSeen is int &&
        request.resource.data.lastSeen > 0;
      allow delete: if false;
    }

    match /report_download_events/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'loginId', 'clientId', 'reportClientId', 'reportLabel',
          'periodStart', 'periodEnd', 'filename', 'reportUpdatedAt', 'downloadedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.loginId is string &&
        request.resource.data.clientId is string &&
        request.resource.data.reportClientId is string &&
        request.resource.data.reportLabel is string &&
        request.resource.data.periodStart is string &&
        request.resource.data.periodEnd is string &&
        request.resource.data.filename is string &&
        request.resource.data.reportUpdatedAt is int &&
        (
          (request.resource.data.downloadedAt is int && request.resource.data.downloadedAt > 0) ||
          request.resource.data.downloadedAt is timestamp
        );
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /client_privacy_consents/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly([
          'uid', 'clientId', 'choice', 'policyVersion', 'decidedAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.clientId is string &&
        clientOwns(request.resource.data.clientId) &&
        (request.resource.data.choice == 'essential' || request.resource.data.choice == 'all') &&
        request.resource.data.policyVersion is string &&
        request.resource.data.decidedAt is int &&
        request.resource.data.updatedAt is int;
      allow update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly([
          'uid', 'clientId', 'choice', 'policyVersion', 'decidedAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.clientId == resource.data.clientId &&
        request.resource.data.decidedAt == resource.data.decidedAt &&
        clientOwns(request.resource.data.clientId) &&
        (request.resource.data.choice == 'essential' || request.resource.data.choice == 'all') &&
        request.resource.data.policyVersion is string &&
        request.resource.data.updatedAt is int;
      allow delete: if isAdmin();
    }

    match /client_activity/{clientId} {
      allow read, write: if false;

      match /sessions/{sessionId} {
        allow read: if isAdmin();
        allow create: if clientOwns(clientId) &&
          request.resource.data.keys().hasOnly([
            'uid', 'clientId', 'loginId', 'deviceId', 'deviceType', 'browser',
            'operatingSystem', 'screen', 'viewport', 'language', 'timezone',
            'connectionType', 'country', 'city', 'isNewDevice', 'analyticsChoice',
            'startedAt', 'lastSeenAt', 'endedAt', 'endReason'
          ]) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.clientId == clientId &&
          request.resource.data.loginId is string &&
          request.resource.data.deviceId is string &&
          request.resource.data.deviceType is string &&
          request.resource.data.browser is string &&
          request.resource.data.operatingSystem is string &&
          request.resource.data.screen is string &&
          request.resource.data.viewport is string &&
          request.resource.data.language is string &&
          request.resource.data.timezone is string &&
          request.resource.data.connectionType is string &&
          request.resource.data.country is string &&
          request.resource.data.city is string &&
          request.resource.data.isNewDevice is bool &&
          (request.resource.data.analyticsChoice == 'essential' || request.resource.data.analyticsChoice == 'all') &&
          request.resource.data.startedAt is int &&
          request.resource.data.lastSeenAt is int &&
          request.resource.data.endedAt == null &&
          request.resource.data.endReason is string;
        allow update: if clientOwns(clientId) &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.clientId == resource.data.clientId &&
          request.resource.data.startedAt == resource.data.startedAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastSeenAt', 'endedAt', 'endReason', 'analyticsChoice', 'country', 'city'
          ]) &&
          request.resource.data.lastSeenAt is int &&
          (request.resource.data.endedAt == null || request.resource.data.endedAt is int) &&
          request.resource.data.endReason is string &&
          (request.resource.data.analyticsChoice == 'essential' || request.resource.data.analyticsChoice == 'all') &&
          request.resource.data.country is string &&
          request.resource.data.city is string;
        allow delete: if isAdmin();
      }

      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if clientOwns(clientId) &&
          request.resource.data.keys().hasOnly([
            'uid', 'clientId', 'sessionId', 'category', 'type', 'label',
            'occurredAt', 'durationMs', 'metadata'
          ]) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.clientId == clientId &&
          request.resource.data.sessionId is string &&
          (request.resource.data.category == 'security' || request.resource.data.category == 'usage') &&
          request.resource.data.type is string &&
          request.resource.data.label is string &&
          request.resource.data.occurredAt is int &&
          request.resource.data.durationMs is int &&
          request.resource.data.metadata is map &&
          request.resource.data.metadata.keys().size() <= 16;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /devices/{deviceId} {
        allow read: if isAdmin();
        allow create: if clientOwns(clientId) &&
          request.resource.data.keys().hasOnly([
            'uid', 'clientId', 'deviceType', 'browser', 'operatingSystem',
            'screen', 'language', 'timezone', 'firstSeenAt', 'lastSeenAt', 'loginCount'
          ]) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.clientId == clientId &&
          request.resource.data.deviceType is string &&
          request.resource.data.browser is string &&
          request.resource.data.operatingSystem is string &&
          request.resource.data.screen is string &&
          request.resource.data.language is string &&
          request.resource.data.timezone is string &&
          request.resource.data.firstSeenAt is int &&
          request.resource.data.lastSeenAt is int &&
          request.resource.data.loginCount is int;
        allow update: if clientOwns(clientId) &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.clientId == resource.data.clientId &&
          request.resource.data.firstSeenAt == resource.data.firstSeenAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deviceType', 'browser', 'operatingSystem', 'screen', 'language',
            'timezone', 'lastSeenAt', 'loginCount'
          ]) &&
          request.resource.data.deviceType is string &&
          request.resource.data.browser is string &&
          request.resource.data.operatingSystem is string &&
          request.resource.data.screen is string &&
          request.resource.data.language is string &&
          request.resource.data.timezone is string &&
          request.resource.data.lastSeenAt is int &&
          request.resource.data.loginCount is int;
        allow delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
